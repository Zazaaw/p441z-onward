# ── Sumber data presensi (ESS / AGHRIS) ──────────────────────────────────
AGHRIS_SUPABASE_URL=
AGHRIS_SUPABASE_SERVICE_ROLE_KEY=
# NIK yang dipakai untuk mengambil profil & presensi
AGHRIS_NIK=

# ── Autentikasi ──────────────────────────────────────────────────────────
# Login diverifikasi lewat Supabase milik portfolio
PORTFOLIO_SUPABASE_URL=
PORTFOLIO_SUPABASE_ANON_KEY=
# Hanya email ini yang boleh masuk
ALLOWED_EMAIL=

# ── Cron ─────────────────────────────────────────────────────────────────
# Wajib diisi. Endpoint /api/cron menolak jalan bila kosong, supaya siapa pun
# yang tahu URL-nya tidak bisa memicu presensi.
CRON_SECRET=

# ── Jejak digital untuk panel login (semuanya opsional) ───────────────────
# Bila kosong, bagian terkait di panel login hilang tanpa membuat error.
GITHUB_USERNAME=
GH_READ_USER_TOKEN_PERSONAL=
WAKATIME_API_KEY=
LASTFM_API_KEY=
LASTFM_USERNAME=

# ── Deploy ───────────────────────────────────────────────────────────────
# Dipakai menyusun URL absolut Open Graph. Contoh: https://onward.p441z.my.id
NEXT_PUBLIC_SITE_URL=
